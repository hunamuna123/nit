PROJECT_NAME="Нить API"
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+asyncpg://nit:nit@localhost:5434/nit
JWT_SECRET=change-me
# ключ авторизации из developers.sber.ru (gigachat api), без него ии выключен. AI_FAKE=true заглушка
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
AI_MODEL=GigaChat-2-Max
# эмбеддинги крутятся локально, первый запуск качает модель ~1.5 гб
EMBEDDING_MODEL=ai-forever/ru-en-RoSBERTa
EMBEDDINGS_ENABLED=true
AI_FAKE=false
S3_ENDPOINT=localhost:9010
S3_ACCESS_KEY=nit
S3_SECRET_KEY=nit-s3-secret
S3_BUCKET=nit-media
